# Backend reads environment variables. See README for shell invocation.
MONGODB_URI=mongodb://127.0.0.1:27017/wawawa
PORT=3001
HOST=127.0.0.1

# Optional OpenAI-compatible speech APIs. Values stay on the server.
# All fields for a capability must be supplied before the UI enables it.
# Base URL includes the version path; endpoints /audio/... are appended.
AUDIO_ASR_BASE_URL=https://api.openai.com/v1
AUDIO_ASR_API_KEY=
AUDIO_ASR_MODEL=
AUDIO_TTS_BASE_URL=https://api.openai.com/v1
AUDIO_TTS_API_KEY=
AUDIO_TTS_MODEL=
AUDIO_TTS_VOICE=
